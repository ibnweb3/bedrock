# Copy to .env (git-ignored) and fill in. Never commit real values.

# Create a free key at https://openalex.org/settings/api
OPENALEX_API_KEY=

# Random secret used to hash author IDs before they enter the graph (rule 6).
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Keep it out of the repo; losing it only means re-running ingest.
AUTHOR_HASH_SALT=

FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=bedrock
